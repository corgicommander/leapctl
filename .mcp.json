{
  "mcpServers": {
    "leapctl": {
      "command": "ruby",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bin/leapctl", "mcp"],
      "env": {
        "LEAP_HOST": "${user_config.host}",
        "LEAP_CERT": "${user_config.cert}",
        "LEAP_KEY": "${user_config.key}"
      },
      "timeout": 600000
    }
  }
}
