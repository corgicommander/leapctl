{
  "name": "leapctl",
  "version": "0.1.1",
  "description": "A Lutron Caséta / RA2 Select companion for Home Assistant: see and change what Pico buttons do in Lutron, Lutron schedules, rooms and names, and add devices without the Lutron app, with a backup before every change.",
  "author": {
    "name": "corgicommander",
    "url": "https://github.com/corgicommander"
  },
  "homepage": "https://github.com/corgicommander/leapctl",
  "repository": "https://github.com/corgicommander/leapctl",
  "license": "MIT",
  "keywords": [
    "lutron",
    "caseta",
    "ra2-select",
    "leap",
    "pico",
    "smart-home",
    "home-assistant"
  ],
  "icon": "./.claude-plugin/icon.png",
  "supportUrl": "https://github.com/corgicommander/leapctl/issues",
  "mcpServers": {
    "leapctl": {
      "command": "ruby",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/exe/leapctl",
        "mcp"
      ],
      "timeout": 1800000
    }
  }
}
